{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "types": ["node", "jest"],
    "noUncheckedIndexedAccess": false, // overriden from the root TSConfig
    "noEmit": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["../src/**/*.ts", "./**/*.ts"],
  "exclude": ["../node_modules", "../build", "../dashboard"]
}
