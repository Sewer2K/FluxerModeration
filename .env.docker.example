# ============================================================
# ClaudeCityMod - Docker Compose configuration
# ============================================================
# Copy this file to .env, then run:
#   docker compose up -d --build
#
# Data is stored on the host under ./data/mongo and ./data/bot.

# ---- Required ------------------------------------------------
TOKEN=YOUR_BOT_TOKEN
OWNER_ID=YOUR_USER_ID

# ---- Private deployment --------------------------------------
# Lock the bot to one server. The bot leaves every other guild.
ALLOWED_GUILD_ID=
# Extra user IDs allowed into the dashboard (comma separated). The owner and
# managers of ALLOWED_GUILD_ID are allowed automatically.
DASHBOARD_ALLOWED_USER_IDS=

# ---- Branding ------------------------------------------------
BRANDING_PUBLIC_NAME=ClaudeCityMod
BRANDING_FULL_NAME=ClaudeCityMod, a Fluxer Bot
BRANDING_DATA_NAME=claudecitymod
BRANDING_RSS_USER_AGENT_NAME=ClaudeCityModRSS
BRANDING_SOCIALS_USER_AGENT_NAME=ClaudeCityMod

# ---- Server --------------------------------------------------
PREFIX=!
LOG_LEVEL=info
DEBUG=false

# ---- Dashboard / API -----------------------------------------
API_ENABLED=true
API_PORT=4000
# Set this to the address people use to reach the dashboard.
DASHBOARD_URL=http://localhost:4000

# Generate strong values, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ADMIN_TOKEN=CHANGE_ME_API_ADMIN_TOKEN
APPEAL_SIGNING_SECRET=CHANGE_ME_APPEAL_SIGNING_SECRET

# Fluxer OAuth app for dashboard login. The redirect URI must be
# DASHBOARD_URL + /auth/callback.
FLUXER_OAUTH_CLIENT_ID=
FLUXER_OAUTH_CLIENT_SECRET=
FLUXER_OAUTH_REDIRECT_URI=http://localhost:4000/auth/callback

# ---- Optional ------------------------------------------------
TERMINATION_APPEAL_TAG=
BRANDING_DOCS_URL=
GLITCHTIP_DSN=
