# ============================================================
# ClaudeCityMod - environment configuration
# ============================================================
# Copy this file to .env and fill in the required values.
# Only TOKEN and MONGO_URI are required for the bot itself.

# Bot token from the Fluxer developer portal.
TOKEN=YOUR_BOT_TOKEN

# MongoDB connection string. With the bundled docker-compose stack this is
# supplied automatically, so you normally do not need to change it there.
MONGO_URI=mongodb://127.0.0.1:27017/claudecitymod

# Command prefix.
PREFIX=!

# Your Fluxer user ID. Enables owner-only commands such as !terminate and !stats.
OWNER_ID=YOUR_USER_ID

# ------------------------------------------------------------
# Private deployment
# ------------------------------------------------------------
# Lock the bot to one server. When set, the bot leaves every other guild and
# ignores commands sent from them. Strongly recommended for a private bot.
ALLOWED_GUILD_ID=

# Extra Fluxer user IDs allowed into the dashboard, comma separated. The owner
# is always allowed. Users with Administrator/Manage Server on ALLOWED_GUILD_ID
# are allowed automatically.
DASHBOARD_ALLOWED_USER_IDS=

# Who terminated guilds/users are told to contact to appeal (!terminate).
# Leave empty to tell users to contact the deployment operator instead.
TERMINATION_APPEAL_TAG=

# ------------------------------------------------------------
# Branding
# ------------------------------------------------------------
# Public bot name shown in messages and embeds.
BRANDING_PUBLIC_NAME=ClaudeCityMod
# Longer name used in banners/nameplates.
BRANDING_FULL_NAME=ClaudeCityMod, a Fluxer Bot
# Lowercase, alphanumeric name used for data and metrics.
BRANDING_DATA_NAME=claudecitymod
# User-Agent names used for outbound RSS/social requests.
BRANDING_RSS_USER_AGENT_NAME=ClaudeCityModRSS
BRANDING_SOCIALS_USER_AGENT_NAME=ClaudeCityMod
# Where help/documentation links point. Defaults to DASHBOARD_URL.
BRANDING_DOCS_URL=

LOG_LEVEL=info
DEBUG=false

# ------------------------------------------------------------
# Process / gateway
# ------------------------------------------------------------
# bot (gateway only), web (dashboard + API only), or all (single process).
CCM_PROCESS=all
BOT_INTERNAL_PORT=4001
BOT_INTERNAL_URL=http://127.0.0.1:4001
BOT_INTERNAL_BIND=127.0.0.1
GATEWAY_SESSION_PATH=
# Where dashboard uploads (welcome backgrounds) are stored.
# UPLOADS_DIR=/data/uploads

# Gateway sharding is automatic by default. Set TOTAL_SHARDS to override it.
# SHARD_GUILDS_PER_SHARD=1500
# SHARD_IDS=0,1

# Self-hosted Fluxer: point at your own instance instead of fluxer.app
# FLUXER_INSTANCE_API=https://api.my-fluxer.example
# FLUXER_INSTANCE_GATEWAY=wss://gateway.my-fluxer.example
# FLUXER_INSTANCE_WEB=https://web.my-fluxer.example
# FLUXER_INSTANCE_MEDIA=https://cdn.my-fluxer.example

# ------------------------------------------------------------
# Dashboard / API (optional but enabled by default in Docker)
# ------------------------------------------------------------
API_ENABLED=false
API_PORT=4000
# Public origin of the dashboard. Used for CORS and OAuth redirects.
DASHBOARD_URL=http://localhost:4000

# Strong random secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ADMIN_TOKEN=
APPEAL_SIGNING_SECRET=

# Fluxer OAuth application used for dashboard login.
FLUXER_OAUTH_CLIENT_ID=
FLUXER_OAUTH_CLIENT_SECRET=
FLUXER_OAUTH_REDIRECT_URI=http://localhost:4000/auth/callback

# ------------------------------------------------------------
# RSS
# ------------------------------------------------------------
RSS_ENABLED=true
RSS_DEFAULT_POLL_INTERVAL_MINUTES=15
RSS_MIN_POLL_INTERVAL_MINUTES=10
RSS_MAX_FEEDS_PER_GUILD=5
RSS_FETCH_TIMEOUT_MS=10000
RSS_MAX_BODY_BYTES=1048576
RSS_MAX_CONCURRENT_FETCHES=8
RSSHUB_BASE_URL=https://rsshub.app
RSSHUB_ACCESS_KEY=

# ------------------------------------------------------------
# Optional error reporting / monitoring
# ------------------------------------------------------------
GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=production
GLITCHTIP_DEBUG=false

HEALTHCHECKS_PING_URL=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
CCM_STATUS_URL=

# Dashboard-only build-time variables (used when building the Vite app).
VITE_GLITCHTIP_DSN=
VITE_GLITCHTIP_ENVIRONMENT=production
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
