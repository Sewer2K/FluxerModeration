# Dashboard build-time env (Vite).
# Copy to .env.production before building for production.

# Set these when the bot uses a self-hosted Fluxer instance.
VITE_FLUXER_INSTANCE_API=https://api.fluxer.app
VITE_FLUXER_INSTANCE_WEB=https://web.fluxer.app
VITE_FLUXER_INSTANCE_MEDIA=https://fluxerusercontent.com
VITE_FLUXER_CLIENT_ID=

VITE_GLITCHTIP_DSN=
VITE_GLITCHTIP_ENVIRONMENT=production

# PostHog - optional; leave empty to disable analytics init
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
